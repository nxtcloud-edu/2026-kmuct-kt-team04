# 서버 전용 — 실제 값은 Git에서 제외된 .env.local에 입력합니다.
API_KEY=
AI_BASE_URL=https://52.79.201.46/v1
AI_MODEL=bedrock-gpt-5.6-sol
KAKAO_REST_API_KEY=
# 로컬 연결 시험에서만 true, 배포에서는 설정하지 않습니다.
VITE_LOCAL_BACKEND=false
# 프론트엔드 환경 변수 예시. 실제 값은 .env 에 넣고 커밋하지 마세요.

# Kakao Maps JavaScript SDK 키 (지도 표시용).
# 카카오 개발자 콘솔에서 발급한 JavaScript 키를 넣고, 사용할 도메인을 등록하세요.
VITE_KAKAO_JS_KEY=

# 참고: 카카오 REST 키는 프론트엔드에서 사용하지 않습니다.
# 장소 키워드 검색은 C의 서버 API를 통해 처리하며, REST 키는 서버에만 둡니다.
# (VITE_KAKAO_REST_KEY 는 의도적으로 두지 않습니다.)

# 방 데이터 어댑터 모드. 기본값은 임시(demo)입니다.
# AWS 배포 후 통합 담당자가 configureBackend(amplify_outputs.json)를 호출한 뒤 live 로 전환하세요.
# VITE_ROOM_ADAPTER=live
